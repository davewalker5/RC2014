10 REM Resistor colour code calculator
20 DIM CN$(12), CD$(12)
30 FOR IX = 1 TO 12 : READ CN$(IX), CD$(IX) : NEXT IX
40 DATA "BLACK  ","BK","BROWN  ","BR","RED    ","RD"
50 DATA "ORANGE ","OR","YELLOW ","YL","GREEN  ","GN"
60 DATA "BLUE   ","BU","VIOLET ","VT","GREY   ","GY"
70 DATA "WHITE  ","WH","GOLD   ","GD","SILVER ","SR"
100 REM Introduction and band selection
110 PRINT ""
120 PRINT "RESISTOR COLOUR CODE CALCULATOR"
130 PRINT "==============================="
135 PRINT
140 PRINT "Enter colours using the displayed two-letter codes."
145 LET BC = 5 : GOSUB 1000 : GOTO 200
150 PRINT ""
160 PRINT "Number of bands (3-6)";
170 INPUT BC
180 IF BC < 3 OR BC > 6 THEN GOTO 190
182 IF BC <> INT(BC) THEN GOTO 190
184 GOSUB 1000 : GOTO 200
190 PRINT "Enter 3, 4, 5 or 6." : GOTO 160
200 REM Main menu
210 PRINT ""
220 PRINT "1) Show colour table"
230 PRINT "2) Convert a value to colour bands"
240 PRINT "3) Convert colour bands to a value"
250 PRINT "B) Change the band count"
260 PRINT "Q) Quit"
265 PRINT
270 PRINT "What do you want to do ";
280 INPUT MC$
285 IF MC$ = "" THEN GOTO 270
290 IF MC$ = "1" THEN GOSUB 1000 : GOTO 210
300 IF MC$ = "2" THEN GOSUB 2000 : GOTO 210
310 IF MC$ = "3" THEN GOSUB 3000 : GOTO 210
320 IF MC$ = "B" OR MC$ = "b" THEN GOTO 150
330 IF MC$ = "Q" OR MC$ = "q" THEN GOTO 500
340 PRINT "Enter 1, 2, 3, B or Q." : GOTO 270
500 PRINT "Done"
510 END
1000 REM Display one table applicable to the selected band count
1010 PRINT ""
1020 IF BC = 3 THEN GOSUB 1150 : GOTO 1060
1030 IF BC = 4 THEN GOSUB 1170 : GOTO 1060
1040 IF BC = 5 THEN GOSUB 1190 : GOTO 1060
1050 PRINT "COLOUR  | CODE | D1 | D2 | D3 | MULT  | ";
1052 PRINT "TOL      | TEMP"
1055 PRINT "--------+------+----+----+----+-------+";
1057 PRINT "----------+----------"
1060 FOR IX = 1 TO 12
1070 GOSUB 6300
1080 PRINT CN$(IX); " | "; CD$(IX); "   | "; F$; " | "; A$;
1085 IF BC >= 5 THEN PRINT " | "; A$;
1087 PRINT " | "; N$;
1090 IF BC >= 4 THEN PRINT " | "; T$;
1100 IF BC = 6 THEN PRINT " | "; P$;
1110 PRINT ""
1120 NEXT IX
1130 IF BC = 3 THEN PRINT "" : PRINT "NO TOLERANCE BAND: +/-20%"
1140 RETURN
1150 PRINT "COLOUR  | CODE | D1 | D2 | MULT"
1160 PRINT "--------+------+----+----+------" : RETURN
1170 PRINT "COLOUR  | CODE | D1 | D2 | MULT  | TOL"
1180 PRINT "--------+------+----+----+-------+---------"
1185 RETURN
1190 PRINT "COLOUR  | CODE | D1 | D2 | D3 | MULT  | TOL"
1200 PRINT "--------+------+----+----+----+-------+---------"
1210 RETURN
2000 REM Convert a resistance value to colour bands
2010 PRINT ""
2020 PRINT "Resistance in ohms";
2030 INPUT VA
2040 LET SD = 2 : LET MN = .1 : LET MX = 990000000
2050 IF BC < 5 THEN GOTO 2060
2052 LET SD = 3 : LET MN = 1
2054 LET MX = 9990000000
2060 IF VA >= MN AND VA <= MX THEN GOTO 2070
2065 PRINT "Range is "; MN; " to "; MX; " ohms." : GOTO 2020
2070 LET EP = -2
2080 LET PW = 10 ^ EP
2090 LET SV = INT(VA / PW + .5)
2100 IF SD = 2 AND SV >= 10 AND SV <= 99 THEN GOTO 2140
2110 IF SD = 3 AND SV >= 100 AND SV <= 999 THEN GOTO 2140
2120 LET EP = EP + 1
2130 IF EP <= 7 THEN GOTO 2080
2135 PRINT "That value cannot be represented." : GOTO 2020
2140 LET RV = SV * PW
2150 IF SD = 3 THEN GOTO 2160
2152 LET B1 = INT(SV / 10)
2154 LET B2 = SV - B1 * 10
2156 GOTO 2180
2160 LET B1 = INT(SV / 100)
2170 LET WK = SV - B1 * 100
2172 LET B2 = INT(WK / 10)
2174 LET B3 = WK - B2 * 10
2180 GOSUB 6000 : LET B4 = MI
2190 IF BC = 3 THEN GOTO 2300
2200 PRINT "Tolerance code (BR RD GN BU VT GD SR or RETURN)";
2210 INPUT IN$
2215 IF IN$ = "" THEN LET ZT = 0 : GOTO 2300
2220 GOSUB 5000
2230 LET OK = 0 : GOSUB 5600
2240 IF OK = 1 THEN GOTO 2245
2242 PRINT "Invalid tolerance colour." : GOTO 2200
2245 LET ZT = IX
2250 IF BC = 4 THEN GOTO 2300
2260 LET B5 = ZT
2270 IF BC = 5 THEN GOTO 2300
2280 PRINT "Temperature code (BR RD OR YL)";
2282 INPUT IN$
2283 IF IN$ = "" THEN GOTO 2280
2284 GOSUB 5000
2286 IF IX >= 2 AND IX <= 5 THEN GOTO 2288
2287 PRINT "Invalid temperature colour." : GOTO 2280
2288 LET B6 = IX
2300 PRINT ""
2310 PRINT "COLOURS: "; CN$(B1 + 1); " "; CN$(B2 + 1); " ";
2320 IF BC >= 5 THEN PRINT CN$(B3 + 1); " ";
2330 PRINT CN$(MI);
2350 IF BC >= 4 AND ZT > 0 THEN PRINT " "; CN$(ZT);
2360 IF BC = 6 AND ZT > 0 THEN PRINT " "; CN$(B6);
2370 PRINT ""
2380 LET NM = RV : GOSUB 6200
2390 PRINT "REPRESENTED VALUE: "; NM; " OHMS ("; N$; ")"
2400 IF BC = 3 THEN PRINT "TOLERANCE: +/-20%" : RETURN
2405 IF ZT = 0 THEN RETURN
2410 LET IX = ZT : GOSUB 5700 : PRINT "TOLERANCE: "; T$
2420 IF BC < 6 THEN RETURN
2430 LET IX = B6 : GOSUB 5800 : PRINT "TEMPERATURE: "; P$
2440 RETURN
3000 REM Convert entered colour bands to a resistance
3010 GOSUB 1000
3015 PRINT ""
3020 PRINT "Band 1 - first digit";
3030 GOSUB 5200
3035 IF IX = -1 THEN GOTO 3020
3040 IF IX >= 2 AND IX <= 10 THEN GOTO 3050
3045 PRINT "Use BR through WH; first cannot be BK." : GOTO 3020
3050 LET B1 = IX
3060 PRINT "Band 2 - second digit";
3070 GOSUB 5200
3075 IF IX = -1 THEN GOTO 3060
3080 IF IX >= 1 AND IX <= 10 THEN GOTO 3090
3085 PRINT "Use BK through WH." : GOTO 3060
3090 LET B2 = IX
3100 IF BC < 5 THEN GOTO 3150
3110 PRINT "Band 3 - third digit";
3120 GOSUB 5200
3125 IF IX = -1 THEN GOTO 3110
3130 IF IX >= 1 AND IX <= 10 THEN GOTO 3140
3135 PRINT "Use BK through WH." : GOTO 3110
3140 LET B3 = IX
3150 IF BC >= 5 THEN GOTO 3154
3152 PRINT "Band 3 - multiplier"; : GOTO 3160
3154 PRINT "Band 4 - multiplier";
3160 GOSUB 5200
3165 IF IX = -1 THEN GOTO 3150
3170 LET OK = 0 : IF IX >= 1 AND IX <= 8 THEN LET OK = 1
3180 IF IX = 11 OR IX = 12 THEN LET OK = 1
3190 IF OK = 1 THEN GOTO 3200
3195 PRINT "Use BK through VT, GD or SR." : GOTO 3150
3200 LET MI = IX : GOSUB 6050
3210 LET SV = (B1 - 1) * 10 + B2 - 1
3220 IF BC >= 5 THEN LET SV = SV * 10 + B3 - 1
3230 LET RV = SV * PW
3240 IF BC = 3 THEN GOTO 3350
3250 IF BC >= 5 THEN GOTO 3254
3252 PRINT "Band 4 - tolerance"; : GOTO 3260
3254 PRINT "Band 5 - tolerance";
3260 GOSUB 5200
3265 IF IX = -1 THEN GOTO 3250
3270 LET OK = 0 : GOSUB 5600
3280 IF OK = 1 THEN GOTO 3290
3285 PRINT "Use BR RD GN BU VT GD or SR." : GOTO 3250
3290 LET ZT = IX
3300 IF BC < 6 THEN GOTO 3350
3310 PRINT "Band 6 - temperature coefficient";
3320 GOSUB 5200
3325 IF IX = -1 THEN GOTO 3310
3330 IF IX >= 2 AND IX <= 5 THEN GOTO 3340
3335 PRINT "Use BR, RD, OR or YL." : GOTO 3310
3340 LET ZP = IX
3350 PRINT ""
3360 LET NM = RV : GOSUB 6200
3370 PRINT "RESISTANCE: "; NM; " OHMS ("; N$; ")"
3380 IF BC = 3 THEN PRINT "TOLERANCE: +/-20%" : RETURN
3390 LET IX = ZT : GOSUB 5700 : PRINT "TOLERANCE: "; T$
3400 IF BC < 6 THEN RETURN
3410 LET IX = ZP : GOSUB 5800 : PRINT "TEMPERATURE: "; P$
3420 RETURN
5000 REM Look up IN$ and return colour index IX, or zero
5010 LET IX = 0
5020 IF LEN(IN$) <> 2 THEN RETURN
5030 LET U$ = ""
5040 FOR LK = 1 TO 2
5050 LET AC = ASC(MID$(IN$, LK, 1))
5060 IF AC >= 97 AND AC <= 122 THEN LET AC = AC - 32
5070 LET U$ = U$ + CHR$(AC)
5080 NEXT LK
5090 FOR LK = 1 TO 12
5100 IF U$ = CD$(LK) THEN LET IX = LK : RETURN
5110 NEXT LK
5120 RETURN
5200 REM Read and look up a colour code
5210 INPUT IN$
5215 IF IN$ = "" THEN LET IX = -1 : RETURN
5220 GOSUB 5000
5230 IF IX > 0 THEN RETURN
5240 IF IN$ = "?" THEN GOTO 5260
5250 PRINT "Unknown code. Enter ? to list codes." : GOTO 5210
5260 PRINT "BK BLACK  BR BROWN  RD RED  OR ORANGE"
5270 PRINT "YL YELLOW GN GREEN  BU BLUE VT VIOLET"
5280 PRINT "GY GREY   WH WHITE  GD GOLD SR SILVER"
5290 GOTO 5210
5600 REM Return whether IX is a valid tolerance colour
5610 IF IX = 2 OR IX = 3 THEN LET OK = 1
5620 IF IX >= 6 AND IX <= 8 THEN LET OK = 1
5630 IF IX = 11 OR IX = 12 THEN LET OK = 1
5640 RETURN
5700 REM Return tolerance display for colour IX
5710 IF IX = 2 THEN LET T$ = "+/-1%"
5720 IF IX = 3 THEN LET T$ = "+/-2%"
5730 IF IX = 6 THEN LET T$ = "+/-0.5%"
5740 IF IX = 7 THEN LET T$ = "+/-0.25%"
5750 IF IX = 8 THEN LET T$ = "+/-0.1%"
5760 IF IX = 11 THEN LET T$ = "+/-5%"
5770 IF IX = 12 THEN LET T$ = "+/-10%"
5780 RETURN
5800 REM Return temperature display for colour IX
5810 IF IX = 2 THEN LET P$ = "100 PPM/C"
5820 IF IX = 3 THEN LET P$ = "50 PPM/C"
5830 IF IX = 4 THEN LET P$ = "15 PPM/C"
5840 IF IX = 5 THEN LET P$ = "25 PPM/C"
5850 RETURN
6000 REM Convert multiplier exponent EP to colour index MI
6010 IF EP = -2 THEN LET MI = 12 : RETURN
6020 IF EP = -1 THEN LET MI = 11 : RETURN
6030 LET MI = EP + 1
6040 RETURN
6050 REM Convert multiplier colour MI to power and exponent
6060 IF MI = 12 THEN LET EP = -2 : LET PW = .01 : RETURN
6070 IF MI = 11 THEN LET EP = -1 : LET PW = .1 : RETURN
6080 LET EP = MI - 1 : LET PW = 10 ^ EP
6090 RETURN
6100 REM Format multiplier exponent EP in N$
6110 IF EP = 0 THEN LET N$ = "1" : RETURN
6120 IF EP = 1 THEN LET N$ = "10" : RETURN
6130 IF EP = 2 THEN LET N$ = "100" : RETURN
6140 IF EP = 3 THEN LET N$ = "1K" : RETURN
6150 IF EP = 4 THEN LET N$ = "10K" : RETURN
6160 IF EP = 5 THEN LET N$ = "100K" : RETURN
6170 IF EP = 6 THEN LET N$ = "1M" : RETURN
6180 LET N$ = "10M" : RETURN
6200 REM Format NM compactly in N$
6210 LET DV = 1 : LET S$ = ""
6220 IF NM < 1000000000 THEN GOTO 6230
6222 LET DV = 1000000000 : LET S$ = "G"
6224 GOTO 6260
6230 IF NM < 1000000 THEN GOTO 6240
6232 LET DV = 1000000 : LET S$ = "M"
6234 GOTO 6260
6240 IF NM >= 1000 THEN LET DV = 1000 : LET S$ = "K"
6260 LET FM = INT(NM / DV * 1000 + .5) / 1000
6270 LET N$ = STR$(FM) : LET N$ = MID$(N$, 2) + S$
6280 RETURN
6300 REM Format one reference-table row for colour IX
6310 LET F$ = "- " : LET A$ = "- " : LET N$ = "-    "
6320 LET T$ = "-       " : LET P$ = "-        "
6330 IF IX > 10 THEN GOTO 6380
6340 LET A$ = STR$(IX - 1) : LET A$ = MID$(A$, 2) + " "
6350 LET F$ = A$ : IF IX = 1 THEN LET F$ = "- "
6360 IF IX > 8 THEN GOTO 6400
6370 LET EP = IX - 1 : GOSUB 6100 : GOTO 6390
6380 IF IX = 11 THEN LET N$ = "0.1" : GOTO 6390
6385 LET N$ = "0.01"
6390 LET N$ = N$ + LEFT$("     ", 5 - LEN(N$))
6400 IF BC < 4 THEN RETURN
6410 LET OK = 0 : GOSUB 5600
6420 IF OK = 0 THEN GOTO 6450
6430 GOSUB 5700 : LET T$ = T$ + LEFT$("        ", 8 - LEN(T$))
6450 IF BC < 6 OR IX < 2 OR IX > 5 THEN RETURN
6460 GOSUB 5800 : LET P$ = P$ + LEFT$("         ", 9 - LEN(P$))
6470 RETURN
