10 REM Rodeo Rumble - random bulls with timing-preserved moo
20 R=218:D=219
30 DL=100:FD=150:REM LCD write delay and scheduler tick delay
40 X0=1:SP=4:REM Four heads, two blank columns between heads
50 DIM G(3,31),BF(1),BC(1),BK(3),WT(3)
60 RESTORE
70 FOR F=0 TO 3:FOR I=0 TO 31
80 READ G(F,I)
90 NEXT I:NEXT F
100 BF(0)=-1:BF(1)=-1:BC(0)=0:BC(1)=0
105 GOSUB 3000:CT=INT(GP/FD)+1
110 GOSUB 900
120 C=56:GOSUB 1000
130 C=12:GOSUB 1000
140 C=6:GOSUB 1000
150 C=1:GOSUB 1000
160 NB=0:F=0:GOSUB 600
170 FOR U=0 TO 3
180 BK(U)=0:WT(U)=1+INT(RND(1)*4)
190 GOSUB 700
200 BC(0)=BC(0)+1
210 NEXT U
220 PRINT "RODEO RUMBLE - RANDOM BULLS AND MOO"
230 PRINT "BULLS HOLD STILL DURING EACH MOO"
240 PRINT "CTRL-C TO STOP; THEN MUTE WITH: "
245 PRINT "OUT 212,24 : OUT 213,0"
250 REM Each bull has its own countdown and random pose choice
260 FOR U=0 TO 3
270 WT(U)=WT(U)-1
280 IF WT(U)>0 THEN 450
290 WT(U)=1+INT(RND(1)*4)
300 F=INT(RND(1)*4):OB=BK(U)
310 IF F=BF(OB) THEN 450
320 NB=-1
330 IF BF(0)=F THEN NB=0
340 IF BF(1)=F THEN NB=1
350 IF NB>=0 THEN 410
360 REM A new pose may only replace a bank with no visible users
370 IF BC(0)=0 THEN NB=0
380 IF BC(1)=0 THEN NB=1
390 IF NB<0 THEN 450:REM Both banks occupied; keep current pose
400 GOSUB 600
410 GOSUB 700
420 BC(OB)=BC(OB)-1:BC(NB)=BC(NB)+1
430 BK(U)=NB
450 NEXT U
460 FOR T=1 TO FD:NEXT T
470 CT=CT-1
480 IF CT>0 THEN 260
490 GOSUB 4180
500 CT=INT(GP/FD)+1+INT(RND(1)*12)
510 GOTO 260
600 REM Upload pose F to unused bank NB; do not touch a visible bank
610 C=64+32*NB:GOSUB 1000
620 FOR I=0 TO 31
630 B=G(F,I):GOSUB 1100
640 NEXT I
650 BF(NB)=F
660 RETURN
700 REM Draw only bull U using the selected bank NB
710 X=X0+U*SP:BS=4*NB
720 C=128+X:GOSUB 1000
730 B=BS:GOSUB 1100
740 B=BS+1:GOSUB 1100
750 C=192+X:GOSUB 1000
760 B=BS+2:GOSUB 1100
770 B=BS+3:GOSUB 1100
780 RETURN
900 REM Conservative LCD settling and write delay
910 FOR Z=1 TO DL:NEXT Z
920 RETURN
1000 OUT R,C:GOSUB 900:RETURN
1100 OUT D,B:GOSUB 900:RETURN
2000 REM Pose 0 - straight, TL TR BL BR tiles
2010 DATA 16,16,24,12,7,3,15,31
2020 DATA 1,1,3,6,28,24,30,31
2030 DATA 5,7,7,3,7,5,7,3
2040 DATA 20,28,28,24,28,20,28,24
2200 REM Pose 1 - left, TL TR BL BR tiles
2210 DATA 16,16,24,12,7,7,31,31
2220 DATA 1,1,3,6,28,16,28,28
2230 DATA 11,15,15,15,31,22,31,15
2240 DATA 8,24,24,0,16,16,16,0
2400 REM Pose 2 - right, TL TR BL BR tiles
2410 DATA 16,16,24,12,7,1,7,7
2420 DATA 1,1,3,6,28,28,31,31
2430 DATA 2,3,3,0,1,1,1,0
2440 DATA 26,30,30,30,31,13,31,30
2600 REM Pose 3 - down, TL TR BL BR tiles
2610 DATA 0,0,16,16,24,12,7,31
2620 DATA 0,0,1,1,3,6,28,31
2630 DATA 5,7,7,3,7,5,7,3
2640 DATA 20,28,28,24,28,20,28,24
3000 REM SID setup; SD is sound delay, DL remains LCD delay
3010 RP=212:DP=213:SD=40
3020 VL=8:RL=9:AT=7:GP=5000
3030 FL=1100:FH=1400:FE=950:FS=25
3040 CL=120:CH=420:CM=300:RE=8
3050 FOR SR=0 TO 24
3060 OUT RP,SR:OUT DP,0
3070 NEXT SR
3080 OUT RP,2:OUT DP,0
3090 OUT RP,3:OUT DP,6
3100 OUT RP,5:OUT DP,AT*16
3110 OUT RP,6:OUT DP,240+RL
3120 OUT RP,23:OUT DP,RE*16+1
3130 OUT RP,24:OUT DP,16+VL
3140 RETURN
4180 F=FL:CF=CL:GOSUB 4600:GOSUB 4700
4190 OUT RP,4:OUT DP,65:REM Pulse gate on, muffled mm
4200 REM Keep the pitch rise; open the mouth with the filter
4210 FOR F=FL TO FH STEP FS
4220 CF=CL+(CH-CL)*(F-FL)/(FH-FL)
4230 GOSUB 4600:GOSUB 4700:GOSUB 4800
4240 NEXT F
4250 REM Rounded OO, easing the filter back from its peak
4260 FOR J=0 TO 15
4270 F=FH-INT(RND(1)*21)
4280 CF=CH+(CM-CH)*J/15
4290 GOSUB 4600:GOSUB 4700:GOSUB 4800
4300 NEXT J
4310 REM Longer falling oo, closing the filter towards a hum
4320 FOR F=FH TO FE STEP -FS
4330 CF=CL+(CM-CL)*(F-FE)/(FH-FE)
4340 GOSUB 4600:GOSUB 4700:GOSUB 4800:GOSUB 4800
4350 NEXT F
4360 OUT RP,4:OUT DP,64:REM Release with the filter still closed
4370 RETURN
4600 REM Write voice 1 frequency; no added pitch jitter
4610 H=INT(F/256):L=F-256*H
4620 OUT RP,0:OUT DP,L
4630 OUT RP,1:OUT DP,H
4640 RETURN
4700 REM Split 11-bit cutoff into low 3 bits and high 8 bits
4710 V=INT(CF):H=INT(V/8):L=V-8*H
4720 OUT RP,21:OUT DP,L
4730 OUT RP,22:OUT DP,H
4740 RETURN
4800 REM Approximate pitch-step hold, dependent on CPU speed
4810 FOR T=1 TO SD:NEXT T
4820 RETURN
