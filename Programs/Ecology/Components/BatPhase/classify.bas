4500 REM Classify the sequence from its phase regions
4510 REM Inputs: NR, CL$(), PL(). Output: FC$
4520 REM Scratch: CI, TP, NS, NA, NB, NE, SF
4530 LET TP = 0 : LET NS = 0 : LET NA = 0
4540 LET NB = 0 : LET NE = 0 : LET SF = 0
4550 LET FC$ = "MIXED OR UNCERTAIN PASS"
4560 IF NR < 1 THEN RETURN
4570 FOR CI = 1 TO NR
4580 LET TP = TP + PL(CI)
4590 IF CL$(CI) = "SEARCH" THEN LET NS = NS + PL(CI)
4600 IF CL$(CI) = "APPROACH" THEN LET NA = NA + PL(CI)
4610 IF CL$(CI) = "BUZZ" THEN LET NB = NB + PL(CI)
4620 IF CL$(CI) = "EXIT" THEN LET NE = NE + PL(CI)
4630 NEXT CI
4640 IF TP <> 0 THEN LET SF = NS / TP
4650 IF NB >= 6 AND NE >= 5 THEN GOTO 4730
4660 IF NB >= 6 THEN FC$ = "FEEDING BUZZ" : RETURN
4670 IF NB > 0 THEN FC$ = "SHORT OR WEAK BUZZ" : RETURN
4680 IF NA >= 5 THEN FC$ = "APPROACH WITHOUT BUZZ" : RETURN
4690 IF NA > 0 THEN FC$ = "BRIEF APPROACH ONLY" : RETURN
4700 IF SF >= 0.85 THEN FC$ = "SEARCH ONLY"
4710 RETURN
4730 LET FC$ = "FEEDING PASS WITH RECOVERY EXIT"
4740 RETURN
