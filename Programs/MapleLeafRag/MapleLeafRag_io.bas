10 REM MIDI CONVERTER DATA FORMAT 2
20 REM SOURCE: MapleLeafRag.mid
30 REM DATA: DURATION,F1,F2,F3,ACTIVE MASK,RETRIGGER MASK,LED MASK
40 REM SID CLOCK: 1000000 HZ; WAVEFORM: Triangle
50 REM STEPS/QUARTER: 4; VOLUME: 10
60 REM INTERRUPT RECOVERY: OUT 212,24 : OUT 213,0
70 RP=212:DP=213:REM SET SID REGISTER AND DATA PORTS
80 W=16:DF=1:REM SET WAVEFORM AND DELAY CALIBRATION
90 FOR R=0 TO 24:OUT RP,R:OUT DP,0:NEXT R:REM CLEAR SID REGISTERS
100 OUT RP,5:OUT DP,0:OUT RP,6:OUT DP,240:REM SET VOICE 1 ENVELOPE
110 OUT RP,12:OUT DP,0:OUT RP,13:OUT DP,240:REM SET VOICE 2 ENVELOPE
120 OUT RP,19:OUT DP,0:OUT RP,20:OUT DP,240:REM SET VOICE 3 ENVELOPE
130 OUT RP,2:OUT DP,0:OUT RP,3:OUT DP,8:REM SET VOICE 1 PULSE WIDTH
140 OUT RP,9:OUT DP,0:OUT RP,10:OUT DP,8:REM SET VOICE 2 PULSE WIDTH
150 OUT RP,16:OUT DP,0:OUT RP,17:OUT DP,8:REM SET VOICE 3 PULSE WIDTH
160 OUT RP,24:OUT DP,10:P=0:REM SET VOLUME AND CLEAR PREVIOUS VOICE MASK
170 READ D,F1,F2,F3,A,G,M:REM READ NEXT PLAYBACK RECORD
180 IF D=0 THEN 250:REM ZERO DURATION MARKS END OF MUSIC
190 B=1:S=0:C=4:F=F1:GOSUB 290:REM UPDATE VOICE 1
200 B=2:S=7:C=11:F=F2:GOSUB 290:REM UPDATE VOICE 2
210 B=4:S=14:C=18:F=F3:GOSUB 290:REM UPDATE VOICE 3
220 OUT 1,M:REM SHOW ACTIVITY ON DIGITAL I/O LEDS
230 FOR T=1 TO D*DF:NEXT T:REM HOLD THIS VOICE STATE
240 P=A:GOTO 170:REM SAVE ACTIVE MASK AND READ NEXT RECORD
250 OUT RP,4:OUT DP,W:OUT RP,11:OUT DP,W:REM RELEASE VOICES 1 AND 2
260 OUT RP,18:OUT DP,W:OUT RP,24:OUT DP,0:REM RELEASE VOICE 3 AND MUTE
270 OUT 1,0:REM CLEAR DIGITAL I/O LEDS
280 PRINT "PLAYBACK COMPLETE":END:REM FINISH WITHOUT ENTERING VOICE ROUTINE
290 X=INT(A/B)-2*INT(A/(2*B))
300 Y=INT(G/B)-2*INT(G/(2*B))
310 Z=INT(P/B)-2*INT(P/(2*B))
320 IF Z=1 AND X=0 THEN OUT RP,C:OUT DP,W
330 IF Y=1 THEN OUT RP,C:OUT DP,W
340 IF X=0 THEN RETURN
350 H=INT(F/256):L=F-256*H
360 OUT RP,S:OUT DP,L:OUT RP,S+1:OUT DP,H
370 IF Z=0 THEN OUT RP,C:OUT DP,W+1
380 IF Y=1 THEN OUT RP,C:OUT DP,W+1
390 RETURN
