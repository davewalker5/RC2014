300 REM Configuration
310 LET PI = 3.14159265
320 LET RD = PI / 180 : REM Degrees to radians
400 REM Read the two airport codes
410 PRINT "AIRPORT BEARING AND DISTANCE"
420 PRINT "============================"
430 PRINT ""
440 PRINT "Airports: ";
450 GOSUB 2100
480 PRINT "From airport (IATA)"
490 INPUT A$
500 GOSUB 2000
510 IF FD = 0 THEN PRINT "Airport not found" : GOTO 480
520 LET L1 = LT : LET O1 = LN : LET F$ = A$
530 PRINT "To airport (IATA)"
540 INPUT A$
550 GOSUB 2000
560 IF FD = 0 THEN PRINT "Airport not found" : GOTO 530
570 LET L2 = LT : LET O2 = LN
600 REM Calculate and display the navigation report
610 GOSUB 1000
620 PRINT ""
630 PRINT "From "; F$; " to "; A$
640 PRINT "Distance: "; DS; " nautical miles"
650 IF UN = 1 THEN PRINT "Initial bearing: undefined" : GOTO 700
660 PRINT "Initial bearing: "; BR; " degrees true"
700 REM Offer another calculation
710 PRINT ""
720 PRINT "More? (Y/N) ";
730 INPUT M$
740 IF M$ = "Y" OR M$ = "y" THEN GOTO 430
750 IF M$ <> "N" AND M$ <> "n" THEN PRINT "Enter Y or N" : GOTO 720
760 END
1000 REM Calculate distance and bearing from L1,O1 to L2,O2
1010 LET D1 = (L2 - L1) * RD
1020 LET D2 = (O2 - O1) * RD
1030 LET HA = SIN(D1 / 2) ^ 2
1040 LET HA = HA + COS(L1 * RD) * COS(L2 * RD) * SIN(D2 / 2) ^ 2
1050 IF HA < 0 THEN LET HA = 0
1060 IF HA > 1 THEN LET HA = 1
1070 IF HA = 1 THEN LET CA = PI : GOTO 1090
1080 LET CA = 2 * ATN(SQR(HA / (1 - HA)))
1090 LET DS = 3440.065 * CA
1100 LET Y1 = SIN(D2) * COS(L2 * RD)
1110 LET X1 = COS(L1 * RD) * SIN(L2 * RD)
1120 LET X1 = X1 - SIN(L1 * RD) * COS(L2 * RD) * COS(D2)
1130 LET UN = 0
1140 IF HA = 0 OR HA = 1 THEN LET UN = 1 : RETURN
1150 IF X1 = 0 AND Y1 > 0 THEN LET AN = PI / 2 : GOTO 1200
1160 IF X1 = 0 AND Y1 < 0 THEN LET AN = 3 * PI / 2 : GOTO 1200
1170 LET AN = ATN(Y1 / X1)
1180 IF X1 < 0 THEN LET AN = AN + PI
1190 IF X1 > 0 AND Y1 < 0 THEN LET AN = AN + 2 * PI
1200 LET BR = AN / RD
1210 IF BR >= 360 THEN LET BR = BR - 360
1220 IF BR < 0 THEN LET BR = BR + 360
1230 RETURN
2000 REM Find airport A$ without retaining the table in memory
2010 RESTORE
2020 LET FD = 0
2030 READ I$, LT, LN
2040 IF I$ = "END" THEN RETURN
2050 IF I$ <> A$ THEN GOTO 2030
2060 LET FD = 1
2070 RETURN
