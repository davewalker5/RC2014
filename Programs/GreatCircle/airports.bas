10 REM Airport records are IATA code, latitude and longitude
20 DATA "LHR",51.470748,-0.459909
30 DATA "LCY",51.505299,0.055278
40 DATA "LGW",51.148744,-0.185739
50 DATA "LTN",51.874699,-0.368333
60 DATA "STN",51.884998,0.235
70 DATA "SOU",50.950298,-1.3568
80 DATA "BOH",50.780483,-1.839576
90 DATA "BHX",52.453899,-1.74803
100 DATA "BRS",51.382326,-2.716453
110 DATA "EMA",52.8311,-1.32806
120 DATA "MAN",53.349375,-2.279521
130 DATA "LPL",53.334863,-2.849637
140 DATA "LBA",53.865898,-1.66057
150 DATA "CDG",49.00896,2.554117
160 DATA "BRU",50.901402,4.48444
170 DATA "AMS",52.308601,4.76389
180 DATA "EIN",51.4500999451,5.37452983856
190 DATA "NCL",55.037958,-1.689577
200 DATA "DUB",53.428713,-6.262121
210 DATA "END",0,0 : REM Sentinel outside valid IATA codes
300 REM Configuration
310 LET PI = 3.14159265
320 LET RD = PI / 180 : REM Degrees to radians
400 REM Read and validate the starting position
410 PRINT "AIRPORT DISTANCES"
415 PRINT "================="
420 PRINT ""
430 PRINT "Latitude (-90 to 90)"
440 INPUT L1
450 IF L1 < -90 OR L1 > 90 THEN PRINT "Invalid latitude" : GOTO 430
460 PRINT "Longitude (-180 to 180)"
470 INPUT O1
480 IF O1 < -180 OR O1 > 180 THEN PRINT "Invalid longitude" : GOTO 460
500 REM Print one result while each airport record is in memory
510 PRINT ""
520 PRINT "IATA", "DISTANCE (NM)"
530 PRINT "----", "-------------"
540 READ IA$, L2, O2
550 IF IA$ = "END" THEN GOTO 600
560 GOSUB 1000
570 PRINT IA$, DS
580 GOTO 540
600 END
1000 REM Calculate distance from L1,O1 to L2,O2 in nautical miles
1010 LET DL = (L2 - L1) * RD
1020 LET DO = (O2 - O1) * RD
1030 LET HA = SIN(DL / 2) ^ 2
1040 LET HA = HA + COS(L1 * RD) * COS(L2 * RD) * SIN(DO / 2) ^ 2
1050 IF HA < 0 THEN LET HA = 0
1060 IF HA > 1 THEN LET HA = 1
1070 IF HA = 1 THEN LET AN = PI : GOTO 1090
1080 LET AN = 2 * ATN(SQR(HA / (1 - HA)))
1090 LET DS = 3440.065 * AN
1100 RETURN
