10 REM Eight-bit binary counter
20 OP = 1 : DL = 50
30 PRINT "BINARY COUNTER"
40 PRINT "DEFAULT DELAY IS "; DL
50 INPUT "DELAY LOOP COUNT (1-5000)"; D
60 IF D < 1 OR D > 5000 THEN PRINT "ENTER 1 TO 5000": GOTO 50
70 INPUT "NUMBER OF 0-255 COUNTS (1-20)"; C
80 IF C < 1 OR C > 20 OR C <> INT(C) THEN PRINT "ENTER 1 TO 20": GOTO 70
90 FOR N = 1 TO C
100 FOR B = 0 TO 255
110 OUT OP, B
120 FOR T = 1 TO D : NEXT T
130 NEXT B
140 NEXT N
150 OUT OP, 0
160 PRINT "COUNT COMPLETE"
170 END
