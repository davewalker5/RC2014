10 REM Larson scanner - three-LED eye sweeps left and right
20 OP = 1 : DL = 100
30 PRINT "LARSON SCANNER"
40 PRINT "DEFAULT DELAY IS "; DL
50 INPUT "DELAY LOOP COUNT (1-5000)"; D
60 IF D < 1 OR D > 5000 THEN PRINT "ENTER 1 TO 5000": GOTO 50
70 INPUT "NUMBER OF SWEEPS (1-100)"; C
80 IF C < 1 OR C > 100 OR C <> INT(C) THEN PRINT "ENTER 1 TO 100": GOTO 70
90 REM Each value is calculated from three adjacent bits
100 FOR N = 1 TO C
110 FOR P = 0 TO 5
120 B = 7 * 2 ^ P : GOSUB 300
130 NEXT P
140 FOR P = 4 TO 1 STEP -1
150 B = 7 * 2 ^ P : GOSUB 300
160 NEXT P
170 NEXT N
180 OUT OP, 0
190 PRINT "SCANNER COMPLETE"
200 END
300 OUT OP, B
310 FOR T = 1 TO D : NEXT T
320 RETURN
