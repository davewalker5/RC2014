10 REM Pseudo-random patterns from an eight-bit LFSR
20 OP = 1 : DL = 100
30 PRINT "PSEUDO-RANDOM LED PATTERNS"
40 PRINT "DEFAULT DELAY IS "; DL
50 INPUT "DELAY LOOP COUNT (1-5000)"; D
60 IF D < 1 OR D > 5000 THEN PRINT "ENTER 1 TO 5000": GOTO 50
70 INPUT "SEED (1-255)"; S
80 IF S < 1 OR S > 255 OR S <> INT(S) THEN PRINT "ENTER 1 TO 255": GOTO 70
90 INPUT "NUMBER OF PATTERNS (1-5000)"; C
100 IF C < 1 OR C > 5000 OR C <> INT(C) THEN PRINT "ENTER 1 TO 5000": GOTO 90
110 FOR N = 1 TO C
120 OUT OP, S
130 FOR T = 1 TO D : NEXT T
140 REM Add taps 0, 2, 3 and 4 and retain odd parity
150 F = (S AND 1) + (INT(S / 4) AND 1)
160 F = F + (INT(S / 8) AND 1) + (INT(S / 16) AND 1)
170 F = F - 2 * INT(F / 2)
180 S = INT(S / 2) + 128 * F
190 NEXT N
200 OUT OP, 0
210 PRINT "PATTERN COMPLETE"
220 END
