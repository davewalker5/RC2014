10 REM Eight-bit reflected Gray-code counter
20 OP = 0 : DL = 50
30 PRINT "GRAY-CODE COUNTER"
40 PRINT "DEFAULT DELAY IS "; DL
50 INPUT "DELAY LOOP COUNT (1-5000)"; D
60 IF D < 1 OR D > 5000 THEN PRINT "ENTER 1 TO 5000": GOTO 50
70 INPUT "NUMBER OF 256-STEP COUNTS (1-20)"; C
80 IF C < 1 OR C > 20 OR C <> INT(C) THEN PRINT "ENTER 1 TO 20": GOTO 70
90 FOR R = 1 TO C
100 FOR N = 0 TO 255
110 REM For positive integers, XOR equals OR minus AND
120 H = INT(N / 2)
130 G = (N OR H) - (N AND H)
140 OUT OP, G
150 FOR T = 1 TO D : NEXT T
160 NEXT N
170 NEXT R
180 OUT OP, 0
190 PRINT "COUNT COMPLETE"
200 END
