10 REM Bouncing bit - one lit LED travels between the ends
20 OP = 1 : DL = 100
30 PRINT "BOUNCING BIT"
40 PRINT "DEFAULT DELAY IS "; DL
50 INPUT "DELAY LOOP COUNT (1-5000)"; D
60 IF D < 1 OR D > 5000 THEN PRINT "ENTER 1 TO 5000": GOTO 50
70 INPUT "NUMBER OF BOUNCES (1-100)"; C
80 IF C < 1 OR C > 100 OR C <> INT(C) THEN PRINT "ENTER 1 TO 100": GOTO 70
90 FOR N = 1 TO C
100 FOR P = 0 TO 7
110 B = 2 ^ P : GOSUB 300
120 NEXT P
130 FOR P = 6 TO 1 STEP -1
140 B = 2 ^ P : GOSUB 300
150 NEXT P
160 NEXT N
170 OUT OP, 0
180 PRINT "BOUNCING COMPLETE"
190 END
300 OUT OP, B
310 FOR T = 1 TO D : NEXT T
320 RETURN
