10 REM DAISY BELL - SID AND MG005 EXPERIMENT
20 REM NOMINAL 25 MS TICKS - CALIBRATE TA AND DL ON YOUR MACHINE
21 REM SOFTWARE TIME IS APPROXIMATE; BASIC ADDS VARIABLE OVERHEAD
22 REM TA ADVANCES TIME EACH PASS; LARGER VALUES PLAY FASTER
23 REM DL ADDS DELAY; SO SHIFTS SPEECH CUES IN TABLE TICKS
24 REM NEGATIVE SO STARTS SPEECH EARLIER; POSITIVE SO LATER
25 REM EDIT THIS TEMPLATE; GENERATION APPENDS DATA AT LINE 1000
30 CLEAR 1000
40 DL=0:TA=1.25:SO=0:REM DELAY; TICK ADVANCE; SPEECH OFFSET
45 REM RP/DP ARE SID REGISTER/DATA PORTS; SP IS THE SPEECH PORT
46 REM W=16 SELECTS TRIANGLE; W+1 ALSO SETS THE SID GATE BIT
50 RP=212:DP=213:SP=31:W=16
55 REM FIRST DATA ROW GIVES NM MUSIC EVENTS AND NS SPEECH CODES
60 READ NM,NS
65 REM MT=TIME; MF=THREE FREQUENCIES; MA=ACTIVE; MG=RETRIGGER
66 REM ST=SPEECH TIME; SC=ALLOPHONE CODE; ARRAYS START AT 1
70 DIM MT(NM),MF(NM,3),MA(NM),MG(NM),ST(NS),SC(NS)
75 REM PRELOAD ALL DATA SO PLAYBACK DOES NOT WAIT FOR READ
80 FOR I=1 TO NM
90 READ MT(I),MF(I,1),MF(I,2),MF(I,3),MA(I),MG(I)
100 NEXT I
110 FOR I=1 TO NS:READ ST(I),SC(I):ST(I)=ST(I)+SO:NEXT I
115 REM CLEAR SID STATE AND SET FAST ATTACK WITH FULL SUSTAIN
120 FOR R=0 TO 24:OUT RP,R:OUT DP,0:NEXT R
130 FOR V=0 TO 2:R=V*7
140 OUT RP,R+5:OUT DP,0:OUT RP,R+6:OUT DP,240
150 NEXT V
160 OUT RP,24:OUT DP,2
165 REM SID VOICES 1/2/3 PLAY MELODY/BASS/WALTZ ACCOMPANIMENT
170 PRINT "DAISY: TWO BAR INTRO THEN FIRST LINE"
175 REM MI/SI POINT TO NEXT EVENTS; T IS THE SHARED MUSICAL TIME
176 REM P IS PREVIOUS ACTIVE MASK; LC COUNTS LATE SYLLABLE STARTS
177 REM FE IS THE END OF THE FINAL SPEECH DRAIN DELAY
180 MI=1:SI=1:P=0:T=0:LC=0:FE=0
190 IF MI>NM THEN 240
200 IF T<MT(MI) THEN 240
210 A=MA(MI):G=MG(MI)
220 FOR V=1 TO 3:F=MF(MI,V):GOSUB 500:NEXT V
230 P=A:MI=MI+1:GOTO 190
240 IF SI>NS THEN 310
250 IF T<ST(SI) THEN 310
260 IF (INP(SP) AND 2)=0 THEN 310
270 IF SI=1 THEN 290
280 IF ST(SI)=ST(SI-1) THEN 300
290 IF T>ST(SI)+4 THEN LC=LC+1
300 OUT SP,SC(SI):SI=SI+1
310 IF MI>NM AND SI>NS THEN 380
320 IF T>=760 THEN 420
330 FOR J=1 TO DL:NEXT J
340 T=T+TA:GOTO 190
350 REM PLAYBACK LOOP GUIDE - THESE COMMENTS ARE OUTSIDE THE LOOP
352 REM 190-230 APPLY ALL DUE MUSIC EVENTS BEFORE SERVICING SPEECH
354 REM 240-260 CHECK THE NEXT CUE AND READY BIT WITHOUT WAITING
356 REM A BUSY SPEECH CARD SKIPS THIS PASS; MUSIC KEEPS ADVANCING
358 REM 270-290 COUNT LATENESS ONLY AT THE FIRST CODE OF A SYLLABLE
360 REM CODES SHARING A CUE TIME BELONG TO THE SAME SYLLABLE
362 REM MORE THAN FOUR TICKS LATE COUNTS ONCE; NO CODES ARE DROPPED
364 REM 300 SENDS ONE CODE; READY MEANS ACCEPTANCE, NOT SOUND ENDED
366 REM 310-340 FINISH, CHECK TIMEOUT, OR ADVANCE THE SHARED CLOCK
368 REM LAST MUSIC EVENT RELEASES ALL VOICES AT T=600
370 REM T=760 LIMITS SPEECH BACKLOG TO FOUR MORE NOMINAL SECONDS
380 REM FINAL PA1 IS SUBMITTED; ALLOW SPEECH TAIL TO DRAIN
385 IF FE=0 THEN FE=T+40
390 IF T<FE THEN 330
400 PRINT "PLAYBACK COMPLETE; LATE SYLLABLES:";LC
410 GOTO 440
420 PRINT "SPEECH TIMEOUT - CHECK CARD OR SLOW THE TEMPO"
440 OUT RP,24:OUT DP,0:END
450 REM SID VOICE ROUTINE AT 500 - CALLED ONCE PER VOICE PER EVENT
455 REM INPUTS: V=VOICE 1-3; F=FREQUENCY; A/G=CURRENT EVENT MASKS
460 REM P=PREVIOUS ACTIVE MASK; MASK BITS 0/1/2 SELECT VOICES 1/2/3
465 REM USES B,R,C,X,Y,Z,H,L AS SCRATCH; DOES NOT CHANGE A,G,P,V,F
470 REM B SELECTS THE VOICE BIT; R IS REGISTER BASE; C IS CONTROL
475 REM X/Y/Z EXTRACT ACTIVE, RETRIGGER AND PREVIOUS ACTIVE BITS
480 REM RELEASE INACTIVE NOTES; LOWER GATE BEFORE RETRIGGERING
485 REM SPLIT THE 16-BIT FREQUENCY INTO LOW L AND HIGH H BYTES
490 REM RAISE GATE FOR NEW OR RETRIGGERED NOTES; KEEP HELD NOTES ON
500 B=2^(V-1):R=(V-1)*7:C=R+4
510 X=INT(A/B)-2*INT(A/(2*B))
520 Y=INT(G/B)-2*INT(G/(2*B))
530 Z=INT(P/B)-2*INT(P/(2*B))
540 IF Z=1 AND X=0 THEN OUT RP,C:OUT DP,W
550 IF Y=1 THEN OUT RP,C:OUT DP,W
560 IF X=0 THEN RETURN
570 H=INT(F/256):L=F-256*H
580 OUT RP,R:OUT DP,L:OUT RP,R+1:OUT DP,H
590 IF Z=0 OR Y=1 THEN OUT RP,C:OUT DP,W+1
600 RETURN
