10 REM INTERACTIVE MG005 ALLOPHONE PLAYER
20 DIM A$(63)
30 FOR I=0 TO 63:READ A$(I):NEXT I
40 PRINT "ENTER ALLOPHONES SEPARATED BY SPACES (Q TO QUIT)"
50 INPUT A$
60 IF A$="Q" THEN END
70 P=1
80 IF P>LEN(A$) THEN GOTO 40
90 IF MID$(A$,P,1)=" " THEN P=P+1:GOTO 80
100 T$=""
110 IF P>LEN(A$) THEN GOTO 150
120 IF MID$(A$,P,1)=" " THEN GOTO 150
130 T$=T$+MID$(A$,P,1):P=P+1
140 GOTO 110
150 I=0
160 IF T$=A$(I) THEN GOTO 200
170 I=I+1
175 IF I<64 THEN GOTO 160
180 PRINT "UNKNOWN ALLOPHONE: ";T$
190 GOTO 80
200 PRINT T$;" = ";I
210 IF (INP(31) AND 2)=0 THEN GOTO 210
220 OUT 31,I
230 GOTO 80
300 DATA PA1,PA2,PA3,PA4,PA5,OY,AY,EH
310 DATA KK3,PP,JH,NN1,IH,TT2,RR1,AX
320 DATA MM,TT1,DH1,IY,EY,DD1,UW1,AO
330 DATA AA,YY2,AE,HH1,BB1,TH,UH,UW2
340 DATA AW,DD2,GG3,VV,GG1,SH,ZH,RR2
350 DATA FF,KK2,KK1,ZZ,NG,LL,WW,XR
360 DATA WH,YY1,CH,ER1,ER2,OW,DH2,SS
370 DATA NN2,HH2,OR1,AR,YR,GG2,EL,BB2
