REM MIDI CONVERTER DATA FORMAT 1
REM SOURCE: {{SOURCE_NAME}}
REM DATA: DURATION,F1,F2,F3,ACTIVE MASK,RETRIGGER MASK
REM SID CLOCK: {{SID_CLOCK_HERTZ}} HZ; WAVEFORM: {{WAVEFORM_NAME}}
REM STEPS/QUARTER: {{STEPS_PER_QUARTER_NOTE}}; VOLUME: {{MASTER_VOLUME}}
REM INTERRUPT RECOVERY: OUT 212,24 : OUT 213,0
RP=212:DP=213:REM SET SID REGISTER AND DATA PORTS
W={{WAVEFORM_VALUE}}:DF={{DELAY_FACTOR}}:REM SET WAVEFORM AND DELAY CALIBRATION
FOR R=0 TO 24:OUT RP,R:OUT DP,0:NEXT R:REM CLEAR SID REGISTERS
OUT RP,5:OUT DP,0:OUT RP,6:OUT DP,240:REM SET VOICE 1 ENVELOPE
OUT RP,12:OUT DP,0:OUT RP,13:OUT DP,240:REM SET VOICE 2 ENVELOPE
OUT RP,19:OUT DP,0:OUT RP,20:OUT DP,240:REM SET VOICE 3 ENVELOPE
OUT RP,2:OUT DP,{{PULSE_LOW}}:OUT RP,3:OUT DP,{{PULSE_HIGH}}:REM SET VOICE 1 PULSE WIDTH
OUT RP,9:OUT DP,{{PULSE_LOW}}:OUT RP,10:OUT DP,{{PULSE_HIGH}}:REM SET VOICE 2 PULSE WIDTH
OUT RP,16:OUT DP,{{PULSE_LOW}}:OUT RP,17:OUT DP,{{PULSE_HIGH}}:REM SET VOICE 3 PULSE WIDTH
OUT RP,24:OUT DP,{{MASTER_VOLUME}}:P=0:REM SET VOLUME AND CLEAR PREVIOUS VOICE MASK
[[LOOP]]READ D,F1,F2,F3,A,G:REM READ NEXT PLAYBACK RECORD
IF D=0 THEN @DONE@:REM ZERO DURATION MARKS END OF MUSIC
B=1:S=0:C=4:F=F1:GOSUB @VOICE@:REM UPDATE VOICE 1
B=2:S=7:C=11:F=F2:GOSUB @VOICE@:REM UPDATE VOICE 2
B=4:S=14:C=18:F=F3:GOSUB @VOICE@:REM UPDATE VOICE 3
FOR T=1 TO D*DF:NEXT T:REM HOLD THIS VOICE STATE
P=A:GOTO @LOOP@:REM SAVE ACTIVE MASK AND READ NEXT RECORD
[[DONE]]OUT RP,4:OUT DP,W:OUT RP,11:OUT DP,W:REM RELEASE VOICES 1 AND 2
OUT RP,18:OUT DP,W:OUT RP,24:OUT DP,0:REM RELEASE VOICE 3 AND MUTE
PRINT "PLAYBACK COMPLETE":END:REM FINISH WITHOUT ENTERING VOICE ROUTINE
[[VOICE]]X=INT(A/B)-2*INT(A/(2*B))
Y=INT(G/B)-2*INT(G/(2*B))
Z=INT(P/B)-2*INT(P/(2*B))
IF Z=1 AND X=0 THEN OUT RP,C:OUT DP,W
IF Y=1 THEN OUT RP,C:OUT DP,W
IF X=0 THEN RETURN
H=INT(F/256):L=F-256*H
OUT RP,S:OUT DP,L:OUT RP,S+1:OUT DP,H
IF Z=0 THEN OUT RP,C:OUT DP,W+1
IF Y=1 THEN OUT RP,C:OUT DP,W+1
RETURN
