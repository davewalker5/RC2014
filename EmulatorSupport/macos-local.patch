@@ -10,6 +11,11 @@
 /*
  *	This replaces the old hard coded serial to tty link
  */
+/* Drain terminal pastes even while the guest has asserted flow control. */
+static uint8_t *input_queue;
+static size_t input_start, input_end, input_capacity;
+static int input_eof;
+
 static unsigned con_ready(struct serial_device *dev)
 {
 	fd_set i, o;
@@ -17,7 +23,8 @@ static unsigned con_ready(struct serial_device *dev)
 	unsigned int r = 0;
 
 	FD_ZERO(&i);
-	FD_SET(0, &i);
+	if (!input_eof)
+		FD_SET(0, &i);
 	FD_ZERO(&o);
 	FD_SET(1, &o);
 	tv.tv_sec = 0;
@@ -29,7 +36,26 @@ static unsigned con_ready(struct serial_device *dev)
 		perror("select");
 		exit(1);
 	}
-	if (FD_ISSET(0, &i))
+	if (FD_ISSET(0, &i)) {
+		if (input_capacity - input_end < 4096) {
+			if (input_start < input_end)
+				memmove(input_queue, input_queue + input_start, input_end - input_start);
+			input_end -= input_start;
+			input_start = 0;
+			if (input_capacity - input_end < 4096) {
+				size_t capacity = input_capacity ? input_capacity * 2 : 65536;
+				uint8_t *queue = realloc(input_queue, capacity);
+				if (!queue) { perror("console input queue"); exit(1); }
+				input_queue = queue;
+				input_capacity = capacity;
+			}
+		}
+		ssize_t count = read(0, input_queue + input_end, 4096);
+		if (count > 0) input_end += count;
+		else if (count == 0) input_eof = 1;
+		else if (errno != EINTR && errno != EAGAIN) { perror("console read"); exit(1); }
+	}
+	if (input_start < input_end)
 		r |= 1;
 	if (FD_ISSET(1, &o))
 		r |= 2;
